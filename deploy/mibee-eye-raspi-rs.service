[Unit]
Description=MiBee Eye RaspPi ONVIF Camera Service
# Order against network-online (not just want it): GB28181's SIP route probe
# and REGISTER must not race DHCP. The app retries on its own as well.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mibee-eye-raspi-rs --config /etc/mibee-eye/config.toml
Environment=LD_PRELOAD=/usr/libexec/aarch64-linux-gnu/libcamera/v4l2-compat.so
SupplementaryGroups=video
Restart=always
RestartSec=5
User=mibee
Group=mibee
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /etc/mibee-eye holds config.toml, which PUT /api/config (SPEC v1 §5)
# persists; /var/lib/mibee-eye holds recordings.
ReadWritePaths=/etc/mibee-eye /var/lib/mibee-eye
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
